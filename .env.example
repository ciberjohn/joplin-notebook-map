# Copy to .env (or run scripts/make-env.sh) — NEVER commit .env
# The token lives in the host Joplin settings: ~/.config/joplin/settings.json → api.token
JOPLIN_API_TOKEN=«replace-with-your-joplin-api-token»
# JOPLIN_API_BASE defaults to http://127.0.0.1:41184 (the host joplin-rest service)
# Alternative: mount the token as a file and point JOPLIN_TOKEN_FILE at it
# JOPLIN_TOKEN_FILE=/run/secrets/joplin-token
CACHE_TTL=60
NOTE_CACHE_TTL=30
